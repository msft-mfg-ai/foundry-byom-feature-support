---
import type { Feature } from '../data/features.ts';
const { feature, repo } = Astro.props as { feature: Feature; repo: string };

const supportBadge: Record<Feature['support_status'], { label: string; cls: string; icon: string }> = {
  supported:      { label: 'Supported',     cls: 'bg-emerald-100 text-emerald-800 ring-emerald-600/20',  icon: '✓' },
  partial:        { label: 'Partial',       cls: 'bg-amber-100 text-amber-800 ring-amber-600/20',        icon: '◐' },
  not_supported:  { label: 'Not supported', cls: 'bg-rose-100 text-rose-800 ring-rose-600/20',           icon: '✕' },
  not_confirmed:  { label: 'Not confirmed', cls: 'bg-slate-100 text-slate-700 ring-slate-500/20',        icon: '?' },
};
const implBadge: Record<Feature['implementation_status'], { label: string; cls: string }> = {
  ga:            { label: 'GA',            cls: 'bg-brand-100 text-brand-800 ring-brand-600/20' },
  preview:       { label: 'Preview',       cls: 'bg-violet-100 text-violet-800 ring-violet-600/20' },
  in_progress:   { label: 'In progress',   cls: 'bg-sky-100 text-sky-800 ring-sky-600/20' },
  not_confirmed: { label: 'Not confirmed', cls: 'bg-slate-100 text-slate-700 ring-slate-500/20' },
};
const s = supportBadge[feature.support_status];
const i = implBadge[feature.implementation_status];
const workflowUrl = `${repo}/actions/workflows/feature-${feature.slug}.yml`;
const sourceUrl = `${repo}/blob/main/features/${feature.slug}/${feature.test_file}`;
const badgeUrl = `${repo}/actions/workflows/feature-${feature.slug}.yml/badge.svg`;
---
<details id={feature.slug} class="group rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition hover:shadow-md open:shadow-md">
  <summary class="cursor-pointer list-none p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-xl font-semibold tracking-tight text-slate-900">{feature.name}</h3>
          <span class={`inline-flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${s.cls}`}>
            <span aria-hidden="true">{s.icon}</span>{s.label}
          </span>
          <span class={`inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ring-1 ring-inset ${i.cls}`}>{i.label}</span>
        </div>
        <p class="mt-2 text-sm text-slate-600">{feature.summary}</p>
      </div>
      <div class="flex shrink-0 items-center gap-3 text-xs text-slate-500">
        <span class="hidden sm:inline">PM: <span class="font-medium text-slate-700">{feature.pm}</span></span>
        <a href={workflowUrl} class="inline-block" target="_blank" rel="noopener">
          <img src={badgeUrl} alt={`${feature.name} workflow status`} class="h-5" />
        </a>
        <svg class="h-5 w-5 transition-transform group-open:rotate-180 text-slate-400" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
      </div>
    </div>
  </summary>

  <div class="border-t border-slate-100 px-6 pb-6 pt-4">
    <div class="grid gap-6 md:grid-cols-3">
      <div class="md:col-span-2 space-y-3">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Description</h4>
        <p class="whitespace-pre-line text-sm leading-relaxed text-slate-700">{feature.description}</p>
        {feature.notes && (
          <div class="rounded-lg bg-amber-50 p-3 text-sm text-amber-900 ring-1 ring-amber-200">
            <span class="font-semibold">Note:</span> {feature.notes}
          </div>
        )}
      </div>
      <div class="space-y-3 text-sm">
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Owner</div>
          <div class="mt-1 text-slate-800">{feature.pm}</div>
        </div>
        <div>
          <div class="text-xs font-semibold uppercase tracking-wider text-slate-500">Links</div>
          <ul class="mt-1 space-y-1">
            <li><a class="text-brand-700 hover:underline" href={sourceUrl} target="_blank" rel="noopener">Test source ↗</a></li>
            <li><a class="text-brand-700 hover:underline" href={workflowUrl} target="_blank" rel="noopener">GitHub Action ↗</a></li>
            {feature.azure_docs && <li><a class="text-brand-700 hover:underline" href={feature.azure_docs} target="_blank" rel="noopener">Azure docs ↗</a></li>}
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-6">
      <div class="mb-2 flex items-center justify-between">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-500">Code sample</h4>
        <a href={sourceUrl} class="text-xs text-brand-700 hover:underline" target="_blank" rel="noopener">View on GitHub</a>
      </div>
      <pre class="overflow-x-auto rounded-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100 ring-1 ring-slate-800"><code>{feature.test_source}</code></pre>
    </div>
  </div>
</details>
