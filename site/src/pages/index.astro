---
import Layout from '../layouts/Layout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { execSync } from 'node:child_process';
import { loadFeatures, CATEGORY_ORDER, CATEGORY_LABEL, CATEGORY_DESCRIPTION, type Category } from '../data/features.ts';

function detectRepoUrl(): string {
  if (process.env.REPO_URL) return process.env.REPO_URL;
  if (process.env.GITHUB_SERVER_URL && process.env.GITHUB_REPOSITORY) {
    return `${process.env.GITHUB_SERVER_URL}/${process.env.GITHUB_REPOSITORY}`;
  }
  try {
    const url = execSync('git remote get-url origin', { stdio: ['ignore', 'pipe', 'ignore'] })
      .toString()
      .trim();
    const m = url.match(/github\.com[:/](.+?)(?:\.git)?$/);
    if (m) return `https://github.com/${m[1]}`;
  } catch {}
  return 'https://github.com/YOUR-ORG/byom-feature-support';
}

const features = loadFeatures();
const repo = detectRepoUrl();

const counts = features.reduce(
  (acc, f) => ({ ...acc, [f.support_status]: (acc[f.support_status] || 0) + 1 }),
  {} as Record<string, number>
);
const total = features.length;
const supported = counts['supported'] || 0;
const partial = counts['partial'] || 0;
const notSupported = counts['not_supported'] || 0;
const notConfirmed = counts['not_confirmed'] || 0;

const byCategory: Record<Category, typeof features> = {
  agents: [],
  endpoints: [],
  routing: [],
  tools: [],
  quality: [],
  ui: [],
  infrastructure: [],
};
for (const f of features) byCategory[f.category].push(f);
---
<Layout>
  <main class="min-h-screen">
    <header class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-brand-900 to-brand-700 text-white">
      <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 24px 24px;"></div>
      <div class="relative mx-auto max-w-6xl px-6 pt-16 pb-12 sm:pt-24 sm:pb-16">
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-200">Azure AI Foundry · APIM Gateway</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">BYOM Feature Support</h1>
        <p class="mt-4 max-w-2xl text-lg text-brand-100">
          Live status of <strong class="font-semibold text-white">bring-your-own-model</strong> features when calling models behind an
          APIM gateway through the Foundry project endpoint. Each card includes a runnable test and a GitHub Actions workflow that
          validates it against a real environment.
        </p>
        <p class="mt-3 max-w-3xl text-sm text-brand-100/90">
          <strong class="font-semibold text-white">Reading the CI badges.</strong>
          A green badge on a <span class="rounded bg-emerald-500/20 px-1.5 py-0.5 font-medium text-emerald-100">supported</span> or <span class="rounded bg-amber-500/20 px-1.5 py-0.5 font-medium text-amber-100">partial</span> card means the feature works today.
          A green <em>regression detector</em> badge on a <span class="rounded bg-rose-500/20 px-1.5 py-0.5 font-medium text-rose-100">not supported</span> card means Foundry still rejects the call with exactly the error we documented — <strong class="font-semibold text-white">red</strong> would mean Microsoft has changed the behavior and the card needs to be updated. A green <em>probe</em> badge on a <span class="rounded bg-slate-500/20 px-1.5 py-0.5 font-medium text-slate-100">not confirmed</span> card means the API shape is unchanged since the last verification.
        </p>
        <div class="mt-8 flex flex-wrap gap-4 text-sm">
          <a href="https://learn.microsoft.com/azure/foundry/agents/how-to/ai-gateway?tabs=api-management&pivots=foundry-portal" class="rounded-lg bg-white px-4 py-2 font-semibold text-brand-900 shadow ring-1 ring-inset ring-white/20 transition hover:bg-brand-50" target="_blank" rel="noopener">📘 BYOM AI Gateway docs →</a>
          <a href={repo} class="rounded-lg bg-white/10 px-4 py-2 font-medium text-white ring-1 ring-inset ring-white/20 backdrop-blur transition hover:bg-white/20" target="_blank" rel="noopener">View on GitHub →</a>
          <a href="#features" class="rounded-lg bg-white/10 px-4 py-2 font-medium text-white ring-1 ring-inset ring-white/20 backdrop-blur transition hover:bg-white/20">Jump to features</a>
        </div>
      </div>
    </header>

    <section class="mx-auto max-w-6xl px-6 pt-8">
      <div class="grid grid-cols-2 gap-3 rounded-2xl bg-white p-4 shadow-lg ring-1 ring-slate-200 sm:grid-cols-5">
        <button type="button" data-filter="all" class="filter-tile is-active rounded-xl bg-slate-50 p-4 text-center transition ring-1 ring-transparent hover:ring-slate-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 data-[active=true]:ring-2 data-[active=true]:ring-slate-400" data-active="true">
          <div class="text-2xl font-bold text-slate-900">{total}</div>
          <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Tracked</div>
        </button>
        <button type="button" data-filter="supported" class="filter-tile rounded-xl bg-emerald-50 p-4 text-center transition ring-1 ring-transparent hover:ring-emerald-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 data-[active=true]:ring-2 data-[active=true]:ring-emerald-500">
          <div class="text-2xl font-bold text-emerald-700">{supported}</div>
          <div class="text-xs font-medium uppercase tracking-wide text-emerald-700">Supported</div>
        </button>
        <button type="button" data-filter="partial" class="filter-tile rounded-xl bg-amber-50 p-4 text-center transition ring-1 ring-transparent hover:ring-amber-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-amber-500 data-[active=true]:ring-2 data-[active=true]:ring-amber-500">
          <div class="text-2xl font-bold text-amber-700">{partial}</div>
          <div class="text-xs font-medium uppercase tracking-wide text-amber-700">Partial</div>
        </button>
        <button type="button" data-filter="not_supported" class="filter-tile rounded-xl bg-rose-50 p-4 text-center transition ring-1 ring-transparent hover:ring-rose-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-500 data-[active=true]:ring-2 data-[active=true]:ring-rose-500">
          <div class="text-2xl font-bold text-rose-700">{notSupported}</div>
          <div class="text-xs font-medium uppercase tracking-wide text-rose-700">Not supported</div>
        </button>
        <button type="button" data-filter="not_confirmed" class="filter-tile rounded-xl bg-slate-100 p-4 text-center transition ring-1 ring-transparent hover:ring-slate-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-500 data-[active=true]:ring-2 data-[active=true]:ring-slate-500">
          <div class="text-2xl font-bold text-slate-700">{notConfirmed}</div>
          <div class="text-xs font-medium uppercase tracking-wide text-slate-500">Not confirmed</div>
        </button>
      </div>
      <p id="filter-status" class="mt-3 hidden text-center text-sm text-slate-500"></p>
    </section>

    <section id="features" class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-end justify-between">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900">Features</h2>
        <p class="text-sm text-slate-500">Click a tile above to filter · click a card to expand it.</p>
      </div>
      <div class="space-y-12">
        {CATEGORY_ORDER.filter((c) => byCategory[c].length > 0).map((cat) => (
          <div class="category-group" data-category={cat}>
            <div class="mb-4 border-b border-slate-200 pb-2">
              <h3 class="text-lg font-semibold text-slate-900">{CATEGORY_LABEL[cat]}</h3>
              <p class="mt-1 text-sm text-slate-500">{CATEGORY_DESCRIPTION[cat]}</p>
            </div>
            <div class="space-y-4">
              {byCategory[cat].map((f) => <FeatureCard feature={f} repo={repo} />)}
            </div>
          </div>
        ))}
      </div>
      <p id="filter-empty" class="hidden py-16 text-center text-sm text-slate-500">No features match the current filter.</p>
    </section>

    <footer class="border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-6 py-8 text-sm text-slate-500">
        Generated from <code class="rounded bg-slate-100 px-1 py-0.5">features/*/feature.json</code> at build time ·
        <a href={repo} class="text-brand-700 hover:underline">source</a>
      </div>
    </footer>
  </main>
</Layout>

<script is:inline>
  (() => {
    const tiles = document.querySelectorAll('.filter-tile');
    const cards = document.querySelectorAll('.feature-card');
    const groups = document.querySelectorAll('.category-group');
    const statusEl = document.getElementById('filter-status');
    const emptyEl = document.getElementById('filter-empty');
    const LABELS = {
      supported: 'Supported',
      partial: 'Partial',
      not_supported: 'Not supported',
      not_confirmed: 'Not confirmed',
    };

    function apply(filter) {
      let visible = 0;
      cards.forEach((el) => {
        const match = filter === 'all' || el.dataset.support === filter;
        el.classList.toggle('hidden', !match);
        if (match) visible++;
      });
      groups.forEach((g) => {
        const anyVisible = g.querySelectorAll('.feature-card:not(.hidden)').length > 0;
        g.classList.toggle('hidden', !anyVisible);
      });
      tiles.forEach((t) => {
        const active = t.dataset.filter === filter;
        t.dataset.active = active ? 'true' : 'false';
        t.classList.toggle('is-active', active);
      });
      if (filter === 'all') {
        statusEl.classList.add('hidden');
      } else {
        statusEl.textContent = `Showing ${visible} “${LABELS[filter] || filter}” feature${visible === 1 ? '' : 's'} — click the tile again to clear.`;
        statusEl.classList.remove('hidden');
      }
      emptyEl.classList.toggle('hidden', visible !== 0);
      const url = new URL(window.location.href);
      if (filter === 'all') url.searchParams.delete('status');
      else url.searchParams.set('status', filter);
      history.replaceState(null, '', url.toString());
    }

    tiles.forEach((tile) => {
      tile.addEventListener('click', () => {
        const target = tile.dataset.filter;
        const current = document.querySelector('.filter-tile[data-active="true"]')?.dataset.filter;
        apply(target === current && target !== 'all' ? 'all' : target);
      });
    });

    const initial = new URLSearchParams(window.location.search).get('status');
    if (initial && Object.prototype.hasOwnProperty.call(LABELS, initial)) apply(initial);
  })();
</script>
