PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project
AI_GATEWAY_CONNECTION_STATIC=apim-xxx-static-for-your-project
AI_GATEWAY_CONNECTION_DYNAMIC=apim-xxx-dynamic-for-your-project

# Per-feature model overrides (defaults are used if unset)
CHAT_MODEL=gpt-5-mini
RESPONSES_MODEL=gpt-5-mini
EMBEDDINGS_MODEL=text-embedding-3-small
IMAGE_MODEL=gpt-image-2
SPEECH_MODEL=gpt-4o-mini-tts
TRANSCRIPTION_MODEL=whisper
