# ---- Foundry project (always required) ----
PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project

# Account-level endpoint (required only for llm-translation)
FOUNDRY_ACCOUNT_ENDPOINT=https://your-foundry.cognitiveservices.azure.com
FOUNDRY_REGION=eastus2

# ---- Gateway connection names ----
AI_GATEWAY_CONNECTION_STATIC=apim-static
AI_GATEWAY_CONNECTION_DYNAMIC=apim-dynamic
AI_GATEWAY_CONNECTION_ANTHROPIC=apim-anthropic
AI_GATEWAY_CONNECTION_MODELGATEWAY=modelgateway-openrouter
AI_GATEWAY_CONNECTION_SERVERLESS=serverless-catalog

# ---- Models ----
# Note: avoid low-TPM deployments here (e.g. gpt-5-mini on the shared test Foundry has a
# ~150 TPM quota and returns 503 'PoolIsInactive' under any real load). gpt-4o-mini is
# a safe default for the smoke tests.
CHAT_MODEL=gpt-4o-mini
REASONING_MODEL=o3-mini
IMAGE_MODEL=gpt-image-1
ANTHROPIC_MODEL=claude-opus-4-6
MODELGATEWAY_MODEL=
SERVERLESS_MODEL=

# ---- Pre-deployed agents (optional; tests skip if unset) ----
PROMPT_AGENT_NAME_STATIC=byom-prompt-static
PROMPT_AGENT_NAME_DYNAMIC=byom-prompt-dynamic
HOSTED_AGENT_NAME_STATIC=
HOSTED_AGENT_NAME_DYNAMIC=

# ---- Tool connections / parameters (optional; each test skips if unset) ----
BING_CONNECTION_ID=
FILE_SEARCH_VECTOR_STORE_ID=
AZURE_AI_SEARCH_CONNECTION_ID=
AZURE_AI_SEARCH_INDEX_NAME=
SHAREPOINT_CONNECTION_ID=
FABRIC_CONNECTION_ID=
A2A_REMOTE_AGENT_ENDPOINT=
LOGIC_APP_RESOURCE_ID=
LOGIC_APP_WORKFLOW_NAME=
COMPUTER_USE_ENVIRONMENT=browser
IMAGE_DEPLOYMENT_NAME=
OPENAPI_SPEC_PATH=
KNOWLEDGE_BASE_ID=
MEMORY_STORE_ID=

# ---- MCP servers (3P + Microsoft 1P) ----
MCP_SERVER_URL=
MCP_SERVER_URL_AGENT_IDENTITY=
MCP_SERVER_URL_OAUTH=
FOUNDRY_IQ_MCP_URL=
WORK_IQ_MCP_URL=
WEB_IQ_MCP_URL=
FABRIC_IQ_MCP_URL=

# ---- Quality / safety ----
EVAL_JUDGE_MODEL=gpt-5-mini
RED_TEAM_TARGET_MODEL=gpt-5-mini

# ---- Extra models for probe tests (each defaults to a sensible value) ----
MODERATION_MODEL=omni-moderation-latest
WEB_SEARCH_MODEL=gpt-5-search-api
VIDEO_MODEL=sora-2
IMAGE_VARIATION_MODEL=dall-e-2
REALTIME_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
